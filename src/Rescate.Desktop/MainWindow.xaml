<Window x:Class="Rescate.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="REVIVO-USB" Icon="Brand/revivo.ico" Width="1380" Height="900" MinWidth="320" MinHeight="200" WindowState="Maximized" Background="#15132E" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <ScrollViewer x:Name="WindowScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
 <Grid Background="#15132E" Width="{Binding ViewportWidth, ElementName=WindowScroll}" Height="{Binding ViewportHeight, ElementName=WindowScroll}" MinHeight="640">
  <Grid.Style><Style TargetType="Grid"><Setter Property="MinWidth" Value="780"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="1"><Setter Property="MinWidth" Value="1060"/></DataTrigger></Style.Triggers></Style></Grid.Style>
  <Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#1E1B45" Padding="16,18"><DockPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="REVIVO-USB 1.0.2" Foreground="#AFA9EC" FontSize="12" Margin="0,12,0,0"/>
   <StackPanel>
    <Image Source="Brand/logo.png" Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,10"/>
    <TextBlock Text="REVIVO-USB" TextAlignment="Center" FontFamily="{StaticResource TitleFont}" FontSize="18" Foreground="White"/>
    <TextBlock Text="Tus archivos, primero." TextAlignment="Center" Foreground="#AFA9EC" Margin="0,6,0,24"/>
    <Button Content="Recuperar USB" Click="Home_Click" Margin="0,0,0,10" ToolTip="Elegir una memoria e iniciar una recuperación"/>
    <Button Content="Abrir recuperación" Click="ResumeRecovery_Click" Margin="0,0,0,10" ToolTip="Continuar con una copia o archivos ya guardados"/>
    <Button x:Name="ResultsNav" Content="Archivos encontrados" Click="ReviewBrowser_Click" IsEnabled="False" Margin="0,0,0,10" ToolTip="Volver a los resultados de esta sesión"/>
    <Button Content="Más opciones ▾" Click="MoreOptions_Click" Margin="0,8,0,0">
     <Button.ContextMenu><ContextMenu Background="#1E1B45" Foreground="#EEEDFE">
      <MenuItem Header="Apoyar REVIVO" Click="Support_Click"/>
      <MenuItem Header="Enviar comentario o reportar un error" Click="Feedback_Click"/><Separator/><MenuItem Header="Abrir carpeta de trabajo" Click="OpenResultsFolder_Click"/>
      <Separator/>
      <MenuItem Header="Diagnóstico de USB" Click="Diagnostic_Click"/>
      <MenuItem Header="Volver a comprobar archivos" Click="ValidateFiles_Click"/>
      <MenuItem Header="Opciones después del rescate" Click="AfterRecovery_Click"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
    <TextBlock Text="Lectura protegida de la USB. Guarda en el disco interno, otra USB o un disco externo." TextWrapping="Wrap" Foreground="#AFA9EC" FontSize="12" Margin="0,24,0,0"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TabControl x:Name="WorkspaceTabs" BorderThickness="0" Background="Transparent">
    <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.ItemContainerStyle>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,6,12,18">
     <TextBlock Text="¿De qué memoria quieres recuperar archivos?" FontFamily="{StaticResource TitleFont}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Conecta tu USB, selecciónala y pulsa Buscar archivos." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,10,0,24"/>
     <DockPanel><Button x:Name="RefreshUsbButton" Content="Actualizar lista" Click="RefreshUsb_Click" DockPanel.Dock="Right" Margin="0"/><TextBlock Text="MEMORIAS USB CONECTADAS" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="UsbHint" Text="Consultando memorias conectadas…" Foreground="{StaticResource Muted}" Margin="0,12,0,8" TextWrapping="Wrap"/>
     <ListBox x:Name="UsbList" MinHeight="135" MaxHeight="265" SelectionChanged="UsbSelection_Changed" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Memoria USB de origen">
      <ListBox.ItemTemplate><DataTemplate><Border Padding="20,16" Margin="2,4" Background="#1E1B45" BorderBrush="#3C3489" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Border Background="#26215C" CornerRadius="8" Width="46" Height="46" HorizontalAlignment="Left"><TextBlock Text="USB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#534AB7"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding FriendlyName}" Foreground="#AFA9EC" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding CapacityLabel}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Background="#1E1B45" CornerRadius="12" Padding="22" Margin="0,24,0,0" BorderBrush="#3C3489" BorderThickness="1"><StackPanel>
      <TextBlock Text="¿Dónde guardamos los archivos?" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold"/>
      <DockPanel Margin="0,12,0,8"><Button Content="Cambiar carpeta" Click="Output_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="OutputBox" IsReadOnly="True" AutomationProperties.Name="Destino: disco interno, otra USB o disco externo"/></DockPanel>
      <TextBlock Text="Se creará una carpeta nueva para cada recuperación. Puedes usar el disco interno, otra USB o un SSD externo en NTFS/exFAT. Mantén el destino conectado. La USB original nunca es el destino." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
     </StackPanel></Border>
     <Border Background="#26215C" CornerRadius="10" Padding="20" Margin="0,20,0,20"><StackPanel><TextBlock Text="Nos encargamos de preparar la copia segura" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="El rescate puede tardar desde minutos hasta varias horas, especialmente si la memoria está dañada. Primero hacemos una copia, después buscamos archivos y preparamos las vistas. Durante la copia estimaremos el tiempo con la velocidad real; no es el tiempo total. No desconectes la USB mientras trabaja." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#AFA9EC"/></StackPanel></Border>
     <Button x:Name="UsbScanButton" Content="Buscar archivos en esta memoria" Click="UsbScan_Click" IsEnabled="False" HorizontalAlignment="Right" Background="#534AB7" Foreground="White" Padding="28,15" FontWeight="SemiBold" Margin="0"/>
     <Expander x:Name="SavedImageSection" Header="Ya tengo una copia de seguridad" Margin="0,22,0,0"><StackPanel Margin="0,12,0,0"><DockPanel><Button Content="Elegir copia…" Click="Image_Click" DockPanel.Dock="Right"/><TextBox x:Name="ImageBox" IsReadOnly="True" Text="Selecciona una copia .img, .dd o .raw"/></DockPanel><Button x:Name="ScanButton" Content="Buscar en la copia" Click="Scan_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/></StackPanel></Expander>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="ReviewTab"><ContentControl x:Name="ReviewHost"><TextBlock Text="Los archivos aparecerán aquí cuando termine la búsqueda." Margin="24"/></ContentControl></TabItem>
   </TabControl>
   <Border Grid.Row="1" Background="#1E1B45" CornerRadius="10" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="StatusText" Text="Elige una memoria para comenzar." TextWrapping="Wrap"/><ProgressBar x:Name="ProgressBar" Height="5" Margin="0,10,0,12" Minimum="0" Maximum="100"/><DockPanel><Button x:Name="CancelButton" Content="Detener" Click="Cancel_Click" IsEnabled="False" DockPanel.Dock="Right" Margin="0"/><Button Content="Detalles de la búsqueda" Click="Warnings_Click" HorizontalAlignment="Left"/></DockPanel></StackPanel></Border>
  </Grid>
  <StackPanel Visibility="Collapsed"><Button x:Name="ReviewedButton"/><ComboBox x:Name="ModeBox" SelectedIndex="0"><ComboBoxItem/><ComboBoxItem/></ComboBox><ComboBox x:Name="SectorBox" SelectedIndex="0"><ComboBoxItem/><ComboBoxItem/></ComboBox><TextBlock x:Name="CountText"/><TextBlock x:Name="SessionText"/><TextBox x:Name="FilterBox"/><DataGrid x:Name="FilesGrid"/><TextBox x:Name="PreviewText"/><Button x:Name="ExportAllButton"/><Button x:Name="ExportSelectedButton"/></StackPanel>
 </Grid>
 </ScrollViewer>
</Window>
