[Unit]
Description=REVIVO private daily backup and health checks
After=network-online.target revivo-feedback.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/revivo-feedback/maintenance.py
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/revivo /var/lib/revivo-feedback
